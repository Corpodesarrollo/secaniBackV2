{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AppSettings": {
    "ApplicationName": "#{ApplicationName}#",
    "MainURL": "#{MainURL}#",
    "PageDomain": "#{PageDomain}#",
    "TicketName": "#{TicketName}#",
    "LoginURL": "#{LoginURL}#",
    "DecryptionKey": "#{DecryptionKey}#",
